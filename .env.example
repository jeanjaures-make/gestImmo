# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Requise en production : crée les comptes que l'organisation n'ouvre pas
# elle-même — l'invitation d'un collaborateur (écran Équipe) produit un
# lien d'activation sans qu'aucun e-mail ne parte.
# ⚠️ Contourne le RLS : jamais de préfixe NEXT_PUBLIC_, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Chariow — paiement des abonnements CaisseOps (Wave, Orange Money, MTN, Moov, Cartes).
# ⚠️ Jamais de préfixe NEXT_PUBLIC_ : ces valeurs restent côté serveur.
#
# Tableau de bord Chariow → Paramètres / Développeurs → Clés API.
# Clé secrète (sk_live_... ou sk_test_...).
CHARIOW_API_KEY=

# Tableau de bord Chariow → Automations → Pulses → Signature Secret (whsec_...).
# Sert à authentifier les notifications Pulse (HMAC-SHA256 du corps reçu).
# Sans elle, le webhook REFUSE tout : un oubli ferme la porte plutôt
# que de l'ouvrir.
CHARIOW_WEBHOOK_SECRET=

# Facultatif. URL de base de l'API Chariow (défaut : https://api.chariow.com/v1).
# CHARIOW_API_URL=https://api.chariow.com/v1

# Facultatif. ID de produit Chariow par défaut.
# CHARIOW_DEFAULT_PRODUCT_ID=

# Balayage quotidien des abonnements échus (Vercel Cron, voir vercel.json).
# N'importe quelle chaîne longue et aléatoire fait l'affaire. Sans elle, la
# route refuse de s'exécuter — un oubli laisse la porte fermée, pas ouverte.
CRON_SECRET=
