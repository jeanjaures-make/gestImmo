# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Requise en production : crée les comptes que l'organisation n'ouvre pas
# elle-même — invitation d'un collaborateur (écran Équipe) et ouverture de
# l'espace d'un locataire (écran Locataires). Sans elle, le portail
# locataire reste inaccessible : personne ne peut y être invité.
# ⚠️ Contourne le RLS : jamais de préfixe NEXT_PUBLIC_, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
