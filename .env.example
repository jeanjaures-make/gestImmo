# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Requise en production : crée les comptes que l'organisation n'ouvre pas
# elle-même — l'invitation d'un collaborateur (écran Équipe) produit un
# lien d'activation sans qu'aucun e-mail ne parte.
# ⚠️ Contourne le RLS : jamais de préfixe NEXT_PUBLIC_, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Moneroo — paiement des abonnements CaisseOps.
# ⚠️ Jamais de préfixe NEXT_PUBLIC_ : ces valeurs restent côté serveur.
#
# Tableau de bord Moneroo → Developers → API Keys.
# Moneroo distingue une clé PUBLIQUE et une clé SECRÈTE : c'est la
# SECRÈTE qui va ici, jamais l'autre. D'où le nom de la variable — le
# terme « API key » laisserait croire qu'elle peut être exposée.
MONEROO_SECRET_KEY=

# Tableau de bord Moneroo → Developers → Webhooks.
# Sert à authentifier les notifications (HMAC-SHA256 du corps reçu).
# Sans elle, le webhook REFUSE tout : un oubli ferme la porte plutôt
# que de l'ouvrir.
MONEROO_WEBHOOK_SECRET=

# Facultatif. L'URL de base est la même en test et en production —
# c'est la CLÉ qui choisit l'environnement, pas l'adresse. Ne la
# renseignez que pour viser un autre hôte.
# MONEROO_API_URL=https://api.moneroo.io/v1

# Balayage quotidien des abonnements échus (Vercel Cron, voir vercel.json).
# N'importe quelle chaîne longue et aléatoire fait l'affaire. Sans elle, la
# route refuse de s'exécuter — un oubli laisse la porte fermée, pas ouverte.
CRON_SECRET=
