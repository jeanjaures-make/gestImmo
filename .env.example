# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Requise en production : crée les comptes que l'organisation n'ouvre pas
# elle-même — l'invitation d'un collaborateur (écran Équipe) produit un
# lien d'activation sans qu'aucun e-mail ne parte.
# ⚠️ Contourne le RLS : jamais de préfixe NEXT_PUBLIC_, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# CinetPay Sandbox — paiement des abonnements CaisseOps.
# ⚠️ Jamais de préfixe NEXT_PUBLIC_ : les clés restent côté serveur.
# Récupérez-les sur https://cinetpay.com → votre site en mode Test.
CINETPAY_ENV=test
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_API_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_CHECKOUT_URL=https://checkout.cinetpay.com
